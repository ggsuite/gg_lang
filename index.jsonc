{
  // The package name, as declared in pubspec.yaml / package.json.
  "name": "gg_lang",

  // 1-2 sentence summary about this repo.
  "summary": "Shared language catalog and project-type detection for the gg toolchain: Dart, Flutter, TypeScript.",

  // 1-3 bullet points: the problem space.
  "domain": [
    "ProjectType, detectProjectType; LanguageCatalog (install/analyze/format/test/publish commands)",
    "TypeScript package managers: update/pin/publish argv, lock files, npm manifest helpers",
    "publish targets, registry resolver and waiter (pub.dev, npm)",
  ],

  // The repos this one depends on and the repos depending on it.
  // Keep the reason or the API behind each entry, not just the name.
  "interfaces": {
    // "<repo-a>": "why / API"
    "uses": {
      "gg_process": "GgProcessWrapper",
      "gg_console_colors": "colored output",
      "dna_ggsuite": "dev: DNA layer: guides, templates",
      "helix": "dev: runDnaTest",
    },

    // "<repo-b>": "why / API"
    "usedBy": {
      "gg_merge": "ProjectType, detectProjectType",
      "gg_multi_commit": "ProjectType, checkProjectType",
      "gg_multi_core": "LanguageCatalog, Manifest, ProjectType, PublishTarget, allLockFileNames, detectProjectType, \u2026",
      "gg_multi_do_publish": "LanguageCatalog, NpmRegistry, NpmRegistryResolver, ProjectType, PubDevRegistry, PublishTarget, \u2026",
      "gg_multi_maintain": "ProjectType, PublishTarget, detectProjectType, detectTypeScriptPackageManager, publishTargetsOf",
      "gg_multi_workspace": "tests only",
      "gg_one": "ProjectType, ProjectTypeX, TypeScriptPackageManager, checkProjectType, detectProjectType, detectTypeScriptPackageManager, \u2026",
      "gg_one_commit": "ProjectType, checkProjectType, detectProjectType, detectTypeScriptPackageManager, hasNpmManifest",
      "gg_one_core": "LanguageCatalog, NpmRegistryResolver, ProjectType, PublishTarget, Registry, TypeScriptPackageManager, \u2026",
      "gg_one_do_publish": "LanguageCatalog, ProjectType, PublishTarget, checkProjectType, detectProjectType, detectTypeScriptPackageManager, \u2026",
      "gg_one_merge": "allLockFileNames",
      "gg_publish": "LanguageCatalog, Manifest, ManifestException, NpmRegistryResolver, ProjectType, PublishTarget, \u2026",
      "gg_test": "ProjectType, checkProjectType, detectProjectType, detectTypeScriptPackageManager, hasNpmScript",
      "gg_version": "LanguageCatalog, Manifest, ManifestException, ProjectType, checkProjectType, detectProjectType, \u2026",
    },
  },
}
