# Dart / Pub
.dart_tool/
.packages
build/
pubspec.lock

# gg
coverage/
# Ignore .gg contents, but keep the check-state file trackable. A bare
# ».gg/« rule must not be used: git never descends into an excluded
# directory, so the »!«-negation below would have no effect.
.gg/*
!.gg/.gg.json
.gg/.gg-publish.json
